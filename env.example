# ============================================================
# 微信群 AI 助手 · 配置示例
# 用法：把本文件复制成 .env（同目录），然后填写 DEEPSEEK_API_KEY
#   复制命令（PowerShell）：Copy-Item env.example .env
# ============================================================

# ---------- 必填 ----------
# 到 https://platform.deepseek.com 申请，充 20 元能跑很久
DEEPSEEK_API_KEY=

# ---------- 模型 ----------
# deepseek-flash：1M 上下文、支持看图、便宜，聊天首选
CHAT_MODEL=deepseek-flash
REASONING_MODEL=deepseek-flash
VISION_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_RETRIES=2

# ---------- 机器人 ----------
# 机器人在群里的名字（要和微信昵称一致，@ 检测靠它）
BOT_NAME=小深
# 别名，逗号分隔（比如群里给它起了外号）
BOT_ALIASES=
# 触发方式：at=只有@才回（推荐） prefix=以 / 开头 all=全量回复 off=关闭
TRIGGER_MODE=at
BOT_PREFIX=/

# 管理员 wxid（逗号分隔）；留空则第一个发 /我是管理员 的人获得权限
ADMIN_WXIDS=
# 允许应答的群 id（逗号分隔）；留空=所有群都应答（不建议）
ALLOWED_ROOMS=

# 单条回复软上限（字）
REPLY_MAX_CHARS=600
# 超过多少字拆成多条发
CHUNK_MAX_CHARS=900
# 思考模式：auto=遇到数学/代码题才开（推荐） on=总是开 off=总是关
THINKING_MODE=auto
# 全局自定义人格（留空用默认人格，群里可以用 /设定 覆盖）
SYSTEM_PROMPT=

# ---------- 风控（防封核心，别调太激进） ----------
RATE_PER_HOUR=20
RATE_PER_DAY=120
RATE_PER_USER_PER_MIN=3
MIN_DELAY_MS=1200
MAX_DELAY_MS=4500
SEGMENT_DELAY_MS=1200
QUIET_ENABLED=true
QUIET_START=23:30
QUIET_END=07:00

# ---------- 微信 ----------
# doctor 会额外扫描这些目录找微信版本（逗号分隔）。装到别处就在这里加
WECHAT_PATHS=D:\WeChatBot,C:\WeChatBot

# ---------- 存储 ----------
DATA_DIR=data
DB_FILE=data/bot.sqlite
MEDIA_DIR=data/media
LOG_DIR=data/logs
BACKUP_DIR=backups
ARCHIVE_DIR=archive

# ---------- 记忆（3 个月滚动） ----------
# 原文保留天数（90 = 3 个月）；超过的归档不删除
MEMORY_RETENTION_DAYS=90
# 每多少轮对话蒸馏一次摘要
DISTILL_EVERY_TURNS=30
# 每多少分钟最多蒸馏一次
DISTILL_EVERY_MINUTES=120
# 上下文预算（tokens）
CONTEXT_TOKENS=12000
MEMORY_TOKENS=1200
SUMMARY_TOKENS=1800
HISTORY_TOKENS=5000

# ---------- 功能开关 ----------
FEATURE_VISION=true
FEATURE_SEARCH=true
FEATURE_BILIBILI=true
FEATURE_VIDEO=true
FEATURE_VOICE=false
FEATURE_DIARY=true

# ---------- 预算 ----------
# 每天最多花多少元，超了就停止回答（0=不限）
DAILY_BUDGET_CNY=5

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_TO_DB=true

# ---------- 运行环境 ----------
NODE_ENV=development
